# App launchers (rcmd)
rcmd - z : open -a Zen
rcmd - a : open -a /Applications/Ghostty.app
rcmd - f : open -a Finder
rcmd - n : open -a /Applications/Notion.app
rcmd - c : open -a /Applications/Notion Calendar.app
rcmd - g : open -a /Applications/Figma.app

# --- Osaurus bindings ---
# Ask Osaurus → opens the active agent chat window and waits for the reply
rcmd - o : execute osascript -e 'tell application "com.sambasoft.osaurus" to do script "Ask Osaurus"'