#!/bin/sh
# Merge the agent-tmux-status hooks into ~/.claude/settings.json.
# Everything else in the file (model, plugins, herdr hooks...) stays machine-local.
input=$(cat)
[ -n "$input" ] || input='{}'
printf '%s\n' "$input" | jq '
  def ours: (.command // "") | test("agent-tmux-status");
  def hook(state; matcher):
    [{hooks: [{type: "command", timeout: 5,
               command: ("bash \"$HOME/.local/bin/agent-tmux-status\" " + state + " claude")}]}
     + (if matcher then {matcher: matcher} else {} end)];
  .hooks = ((.hooks // {})
    | map_values(map(.hooks |= map(select(ours | not))) | map(select(.hooks | length > 0)))
    | with_entries(select(.value | length > 0)))
  # async: naming work (git, jq) must not delay sending the prompt
  | .hooks.UserPromptSubmit += [hook("working"; null)[0] | .hooks[0].async = true]
  | .hooks.PermissionRequest += hook("waiting"; null)
  | .hooks.PreToolUse       += hook("waiting"; "AskUserQuestion|ExitPlanMode")
  | .hooks.PostToolUse      += hook("resume"; null)
  | .hooks.Notification     += hook("waiting"; "permission_prompt|elicitation_dialog|elicitation_url_dialog")
  | .hooks.Stop             += hook("done"; null)
  | .hooks.StopFailure      += hook("error"; null)
  | .hooks.SessionEnd       += hook("reset"; null)
  # agent-tmux-status is the single bell source; native Claude alerts would double it
  | .preferredNotifChannel = "notifications_disabled"
'
